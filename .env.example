DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ausmarket"

# ASX stock quotes (Phase 2/3) — optional. Get a free key at
# https://twelvedata.com. Without this set, /stocks/[symbol] falls
# back to labelled mock data automatically — nothing breaks if you
# leave it blank.
TWELVE_DATA_API_KEY=""

# Future data providers — leave blank until a licensed
# feed / API key is actually configured. The mock provider is used
# whenever these are unset.
MARKET_DATA_PROVIDER=""
ASX_DATA_PROVIDER=""
ASX_DATA_API_KEY=""
